# Backend environment variables (copy to .env and fill; .env is gitignored)
MYSQL_URL=jdbc:mysql://localhost:3306/wechat_ai?useSSL=false&serverTimezone=Asia/Shanghai
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
WECHAT_APPID=your_wechat_appid
WECHAT_APPSECRET=your_wechat_appsecret
WECHAT_TOKEN=your_wechat_token
WECHAT_AESKEY=your_wechat_aeskey
LLM_API_KEY=your_llm_api_key
TTS_API_KEY=your_tts_api_key
QWEN_VL_API_KEY=your_qwen_vl_api_key
TRANSLATE_API_KEY=your_translate_api_key
TRANSLATE_APP_ID=your_translate_app_id
MCP_DIDI_API_KEY=your_didi_api_key
MCP_MCDONALDS_API_KEY=your_mcdonalds_api_key
MCP_LIEPIN_CREDENTIAL=your_liepin_credential
QDRANT_API_KEY=your_qdrant_api_key
EMBEDDING_API_KEY=your_embedding_api_key
MAIL_USERNAME=your_qq_mail@qq.com
MAIL_PASSWORD=your_mail_auth_code
KUAIDI100_API_KEY=your_kuaidi100_api_key
FILESYSTEM_ALLOWED_DIR=C:/path/allowed
